{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git remote -v)",
      "Bash(git ls-files)",
      "Bash(git ls-files *)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git restore --staged *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git pull)",
      "Bash(git pull --rebase)",
      "Bash(git pull --ff-only)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(git push origin HEAD)",
      "Bash(gh repo view kclab281/public-pages *)",
      "Bash(gh api repos/kclab281/public-pages/pages)",
      "Bash(gh api repos/kclab281/public-pages/pages --jq *)",
      "Bash(gh api repos/kclab281/public-pages/contents/*)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(dig +short *)",
      "Bash(dig *)",
      "Bash(host *)",
      "Bash(nslookup *)",
      "Bash(curl -sI https://hittsumi281.com/*)",
      "Bash(curl -sI https://hittsumi281.com)",
      "Bash(curl -sI https://kclab281.github.io/*)",
      "Bash(curl -sIL https://hittsumi281.com/*)",
      "Bash(xmllint --noout *)",
      "Bash(tidy -q -e *)",
      "WebFetch(domain:hittsumi281.com)",
      "WebFetch(domain:kclab281.github.io)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:docs.claude.com)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*credentials*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",

      "Edit(/CNAME)",
      "Write(/CNAME)",
      "Edit(/.nojekyll)",
      "Write(/.nojekyll)",
      "Edit(CNAME)",
      "Write(CNAME)",
      "Edit(.nojekyll)",
      "Write(.nojekyll)",

      "Bash(rm -rf /*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf .git*)",
      "Bash(rm -rf .git)",
      "Bash(rm -rf .claude*)",
      "Bash(rm CNAME)",
      "Bash(rm .nojekyll)",
      "Bash(rm -f CNAME)",
      "Bash(rm -f .nojekyll)",

      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",

      "Bash(gh api * --method PUT*)",
      "Bash(gh api * --method POST*)",
      "Bash(gh api * --method PATCH*)",
      "Bash(gh api * --method DELETE*)",
      "Bash(gh api * -X PUT*)",
      "Bash(gh api * -X POST*)",
      "Bash(gh api * -X PATCH*)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api repos/kclab281/public-pages/pages -f *)",
      "Bash(gh api repos/kclab281/public-pages/pages -F *)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",

      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-pages-infra.sh\""
          }
        ]
      }
    ]
  }
}
